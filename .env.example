# ─────────────────────────────────────────────
# LabelGuard — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_NAME=LabelGuard
SECRET_KEY=change_this_to_a_long_random_secret_key_min_32_chars

# ── Database (PostgreSQL) ─────────────────────
POSTGRES_USER=labelguard
POSTGRES_PASSWORD=labelguard_pass
POSTGRES_DB=labelguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://labelguard:labelguard_pass@db:5432/labelguard

# ── MinIO (Object Storage) ────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_IMAGES=label-images
MINIO_BUCKET_REPORTS=reports
MINIO_SECURE=false

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────
JWT_SECRET_KEY=change_this_to_another_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google Cloud Vision API ───────────────────
# Get from: https://console.cloud.google.com/apis/library/vision.googleapis.com
# Free tier: 1000 units/month
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# ── Seed Admin User ───────────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@labelguard.gov.in
ADMIN_PASSWORD=Admin@1234

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
