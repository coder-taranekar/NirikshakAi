{
  "expo": {
    "name": "LabelGuard",
    "slug": "labelguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.gov.labelguard",
      "infoPlist": {
        "NSCameraUsageDescription": "LabelGuard needs camera access to scan product labels for compliance checking.",
        "NSPhotoLibraryUsageDescription": "LabelGuard needs photo library access to upload product label images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d4ed8"
      },
      "package": "in.gov.labelguard",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LabelGuard needs camera access to scan product labels."
        }
      ]
    ],
    "scheme": "labelguard",
    "extra": {
      "apiUrl": "http://10.0.2.2:8000"
    }
  }
}
